{
  "rules": {
    "lobbies": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('hostId').val() === auth.uid",
        ".validate": "$code.matches(/^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$/) && newData.hasChildren(['hostId', 'createdAt', 'settings', 'stage']) && (data.exists() || (!newData.child('picks').exists() && !newData.child('votes').exists() && !newData.child('tiebreak').exists() && !newData.child('nextLobby').exists() && !newData.child('randomPick').exists()))",
        "hostId": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "settings": {
          ".validate": "newData.hasChildren(['numMovies', 'unlimitedVotes'])",
          "numMovies": {
            ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 5"
          },
          "unlimitedVotes": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "stage": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          ".validate": "(!data.exists() && newData.val() === 'PICKING') || (data.val() === 'PICKING' && newData.val() === 'VOTING') || (data.val() === 'VOTING' && newData.val() === 'DONE') || (data.val() === 'PICKING' && newData.val() === 'DONE' && newData.parent().child('randomPick').exists())"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "$uid === auth.uid && (newData.isNumber() || newData.hasChildren(['name', 'joinedAt']))",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "picks": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && root.child('lobbies/' + $code + '/stage').val() === 'PICKING' && root.child('lobbies/' + $code + '/members/' + auth.uid).exists()",
            ".validate": "newData.hasChildren()",
            "$movieId": {
              ".validate": "$movieId.matches(/^[0-9]{1,10}$/) && newData.hasChild('title')",
              "title": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
              },
              "year": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
              },
              "posterPath": {
                ".validate": "newData.isString() && newData.val().matches(/^\\/[A-Za-z0-9_.-]{1,100}$/)"
              },
              "backdropPath": {
                ".validate": "newData.isString() && newData.val().matches(/^\\/[A-Za-z0-9_.-]{1,100}$/)"
              },
              "overview": {
                ".validate": "newData.isString() && newData.val().length <= 2000"
              },
              "rating": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "votes": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && root.child('lobbies/' + $code + '/stage').val() === 'VOTING' && root.child('lobbies/' + $code + '/members/' + auth.uid).exists()",
            ".validate": "(root.child('lobbies/' + $code + '/settings/unlimitedVotes').val() === true && newData.hasChildren()) || (root.child('lobbies/' + $code + '/settings/unlimitedVotes').val() === false && newData.isString() && newData.val().matches(/^[0-9]{1,10}$/))",
            "$movieId": {
              ".validate": "$movieId.matches(/^[0-9]{1,10}$/) && newData.val() === true"
            }
          }
        },
        "tiebreak": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid && !data.exists()",
          ".validate": "root.child('lobbies/' + $code + '/stage').val() === 'DONE' && newData.isString() && newData.val().matches(/^[0-9]{1,10}$/)"
        },
        "randomPick": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid && !data.exists()",
          ".validate": "data.parent().child('stage').val() === 'PICKING' && newData.parent().child('stage').val() === 'DONE' && newData.hasChildren(['movieId', 'pickedBy']) && root.child('lobbies/' + $code + '/picks/' + newData.child('pickedBy').val() + '/' + newData.child('movieId').val()).exists()",
          "movieId": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,10}$/)"
          },
          "pickedBy": {
            ".validate": "newData.isString() && newData.val().matches(/^[^\\/.#$\\[\\]]{1,128}$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "nextLobby": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid && !data.exists()",
          ".validate": "root.child('lobbies/' + $code + '/stage').val() === 'DONE' && newData.isString() && newData.val().matches(/^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$/) && newData.val() !== $code"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
